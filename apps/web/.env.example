# ============================================================
# AgendaFlow Web — Environment Variables
# ============================================================

# API Backend URL (usada no rewrite do next.config.ts)
NEXT_PUBLIC_API_URL=http://localhost:3001

# WebSocket URL (Evolution direta para Socket.io)
NEXT_PUBLIC_WS_URL=http://localhost:3001

# App URL (usada em redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth
NEXTAUTH_SECRET=TROQUE_ESTE_SECRET
NEXTAUTH_URL=http://localhost:3000
