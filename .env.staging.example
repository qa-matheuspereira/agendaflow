# ─── APPLICATION ──────────────────────────────────────────────────────────────
NODE_ENV=staging
PORT=3001
API_PREFIX=api/v1
FRONTEND_URL=https://staging-app.seudominio.com

# ─── DATABASE ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://agendaflow:SENHA_AQUI@postgres:5432/agendaflow_staging

# ─── REDIS ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REDIS_SENHA_AQUI

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=staging_jwt_secret_min32chars_troque
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=staging_refresh_secret_min32chars_troque
JWT_REFRESH_EXPIRY=7d

# ─── EVOLUTION API ────────────────────────────────────────────────────────────
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=agendaflow_evolution_key_staging
EVOLUTION_WEBHOOK_VERIFY_TOKEN=webhook_token_staging

# ─── MERCADO PAGO ─────────────────────────────────────────────────────────────
MP_PLATFORM_ACCESS_TOKEN=TEST-xxxxxxxxxxxx
MP_PLATFORM_PUBLIC_KEY=TEST-xxxxxxxxxxxx
MP_WEBHOOK_SECRET=staging_mp_webhook_secret

# ─── SUPER ADMIN ──────────────────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@agendaflow.staging
SUPER_ADMIN_PASSWORD=senha_admin_staging_troque

# ─── LOGGING ──────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=json

# ─── THROTTLE ─────────────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=200
