# ============================================================
# AgendaFlow API — Environment Variables
# Copie este arquivo para .env e preencha os valores
# ============================================================

# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://agendaflow:agendaflow_dev_pass@localhost:5432/agendaflow_dev?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=agendaflow_redis_pass

# JWT
JWT_SECRET=TROQUE_ESTE_SECRET_POR_UM_VALOR_SEGURO_DE_32_CHARS_MINIMO
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=TROQUE_ESTE_REFRESH_SECRET_TAMBEM
JWT_REFRESH_EXPIRY=7d

# WPPConnect-server (WhatsApp)
# WPPCONNECT_API_URL: URL onde o container wppconnect está acessível
# WPPCONNECT_TOKEN: token gerado via POST /api/<sessão>/<SECRET_KEY>/generate-token
# WPPCONNECT_WEBHOOK_SECRET: segredo que você adiciona na URL do webhook configurada no WPPConnect
#   Webhook URL a configurar: POST https://<sua-api>/api/v1/whatsapp/webhook?secret=<WPPCONNECT_WEBHOOK_SECRET>
# WPPCONNECT_SECRET_KEY: SECRET_KEY do container WPPConnect (usado para gerar tokens)
WPPCONNECT_API_URL=http://localhost:21465
WPPCONNECT_TOKEN=SEU_TOKEN_GERADO_VIA_WPPCONNECT
WPPCONNECT_WEBHOOK_SECRET=TOKEN_SECRETO_DO_WEBHOOK
WPPCONNECT_SECRET_KEY=agendaflow_wpp_secret

# Mercado Pago (Plataforma — usado para billing do SaaS)
# Cada tenant tem sua própria config no banco de dados
MP_PLATFORM_ACCESS_TOKEN=APP_USR-xxx
MP_PLATFORM_PUBLIC_KEY=APP_USR-xxx
MP_WEBHOOK_SECRET=SEU_WEBHOOK_SECRET_MP

# Logging
LOG_LEVEL=debug
#SLOG_FORMAT=json

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# n8n Webhooks (opcional)
#N8N_WEBHOOK_BASE_URL=http://localhost:5678
#N8N_API_KEY=

# Super Admin (seed)
SUPER_ADMIN_EMAIL=super@agendaflow.com.br
SUPER_ADMIN_PASSWORD=TROQUE_ESTA_SENHA
