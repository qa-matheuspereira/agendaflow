// AgendaFlow SaaS — Prisma Schema Completo
// FASE 1 — Modelagem de Banco de Dados
// PostgreSQL + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum PlanType {
  BASIC
  PRO
  ENTERPRISE
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
  TRIAL
}

enum SchedulingMode {
  SCHEDULE_ONLY
  QUEUE_ONLY
  HYBRID
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  RECEPTIONIST
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum QueueStatus {
  WAITING
  CALLED
  IN_SERVICE
  DONE
  LEFT
}

enum QueuePriority {
  NORMAL
  VIP
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  CASH
  COURTESY
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum NotificationType {
  APPOINTMENT_CONFIRMED
  APPOINTMENT_REMINDER
  APPOINTMENT_CANCELLED
  APPOINTMENT_NO_SHOW
  QUEUE_CALLED
  QUEUE_POSITION
  PAYMENT_LINK
  RETURN_REMINDER
  CUSTOM
}

enum DocumentType {
  PHOTO
  PDF
  IMAGE
}

// ============================================================
// SUPER ADMIN — Plataforma
// ============================================================

model Platform {
  id        String   @id @default(uuid())
  name      String   @default("AgendaFlow")
  version   String   @default("1.0.0")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// TENANT — Empresa
// ============================================================

model Company {
  id              String        @id @default(uuid())
  name            String
  slug            String        @unique // usado em URLs e identificação
  email           String        @unique
  phone           String?
  document        String?       // CNPJ ou CPF
  logoUrl         String?
  planType        PlanType      @default(TRIAL)
  status          CompanyStatus @default(TRIAL)
  schedulingMode  SchedulingMode @default(HYBRID)
  timezone        String        @default("America/Sao_Paulo")
  trialEndsAt     DateTime?
  subscriptionId  String?       // ID no sistema de billing
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relações
  users               User[]
  collaborators       Collaborator[]
  clients             Client[]
  services            Service[]
  serviceCategories   ServiceCategory[]
  appointments        Appointment[]
  queueEntries        QueueEntry[]
  businessHours       BusinessHour[]
  specialDays         SpecialDay[]
  breaks              Break[]
  whatsappConfig      WhatsappConfig?
  mercadopagoConfig   MercadopagoConfig?
  businessRules       BusinessRules?
  notifications       Notification[]
  auditLogs           AuditLog[]
  payments            Payment[]

  @@index([slug])
  @@index([status])
}

// ============================================================
// USERS — Usuários do Painel Web
// ============================================================

model User {
  id           String   @id @default(uuid())
  companyId    String
  name         String
  email        String
  passwordHash String
  role         UserRole @default(RECEPTIONIST)
  phone        String?
  avatarUrl    String?
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]

  @@unique([companyId, email])
  @@index([companyId])
  @@index([email])
}

// ============================================================
// COLLABORATORS — Profissionais que atendem
// ============================================================

model Collaborator {
  id                  String   @id @default(uuid())
  companyId           String
  name                String
  whatsappNumber      String   // número sem formatação: 5511999999999
  email               String?
  avatarUrl           String?
  bio                 String?
  isActive            Boolean  @default(true)
  // Permissões WhatsApp (granular)
  canViewSchedule     Boolean  @default(true)
  canCreateSchedule   Boolean  @default(true)
  canEditSchedule     Boolean  @default(true)
  canDeleteSchedule   Boolean  @default(false)
  canCreateBreak      Boolean  @default(true)
  canCallNextQueue    Boolean  @default(true)
  canFinishService    Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  services     CollaboratorService[]
  appointments Appointment[]
  breaks       Break[]
  queueEntries QueueEntry[]  // atendimentos de fila

  @@unique([companyId, whatsappNumber])
  @@index([companyId])
  @@index([whatsappNumber])
}

// ============================================================
// CLIENTS — Clientes (identificados pelo WhatsApp)
// ============================================================

model Client {
  id              String    @id @default(uuid())
  companyId       String
  name            String
  whatsappNumber  String    // número sem formatação: 5511999999999
  email           String?
  birthdate       Date?
  notes           String?
  avatarUrl       String?
  isBlocked       Boolean   @default(false)
  blockedReason   String?
  blockedAt       DateTime?
  absenceCount    Int       @default(0)
  trustScore      Int       @default(100) // 0-100
  lastVisitAt     DateTime?
  totalVisits     Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointments  Appointment[]
  queueEntries  QueueEntry[]
  clientPlan    ClientPlan?
  absences      ClientAbsence[]

  @@unique([companyId, whatsappNumber])
  @@index([companyId])
  @@index([whatsappNumber])
  @@index([companyId, isBlocked])
}

// Plano mensalista do cliente
model ClientPlan {
  id                    String    @id @default(uuid())
  clientId              String    @unique
  companyId             String
  serviceId             String?   // serviço incluído (null = qualquer)
  monthlyQuota          Int       // quantidade de atendimentos/mês
  usedThisMonth         Int       @default(0)
  cycleStartDay         Int       @default(1) // dia do mês que renova
  price                 Decimal   @db.Decimal(10, 2)
  isActive              Boolean   @default(true)
  renewsAt              DateTime
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id])

  @@index([companyId])
}

// Registro de faltas (ausências sem cancelamento)
model ClientAbsence {
  id            String      @id @default(uuid())
  clientId      String
  companyId     String
  appointmentId String?
  occurredAt    DateTime    @default(now())
  notes         String?

  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([clientId])
  @@index([companyId])
}

// ============================================================
// SERVICES — Serviços oferecidos
// ============================================================

model ServiceCategory {
  id        String    @id @default(uuid())
  companyId String
  name      String
  color     String?   // hex color para UI
  icon      String?
  order     Int       @default(0)
  createdAt DateTime  @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  services Service[]

  @@index([companyId])
}

model Service {
  id                   String   @id @default(uuid())
  companyId            String
  categoryId           String?
  name                 String
  description          String?
  durationMinutes      Int      // duração base em minutos
  breakAfterMinutes    Int      @default(0) // pausa após atendimento
  price                Decimal  @db.Decimal(10, 2)
  // Regras especiais
  requiresDocument     Boolean  @default(false)
  documentInstruction  String?  // instrução do que enviar
  requiresAdvancePayment     Boolean @default(false)
  advancePaymentType         String? // PERCENTAGE | FIXED
  advancePaymentValue        Decimal? @db.Decimal(10, 2)
  // Controle
  isActive             Boolean  @default(true)
  maxDailyAppointments Int?     // limite por dia (null = sem limite)
  order                Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category      ServiceCategory? @relation(fields: [categoryId], references: [id])
  collaborators CollaboratorService[]
  appointments  Appointment[]
  clientPlans   ClientPlan[]

  @@index([companyId])
  @@index([companyId, isActive])
}

// Relação N:N Colaborador <-> Serviço
model CollaboratorService {
  collaboratorId String
  serviceId      String
  assignedAt     DateTime @default(now())

  collaborator Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([collaboratorId, serviceId])
}

// ============================================================
// BUSINESS HOURS — Grade de horários
// ============================================================

model BusinessHour {
  id               String    @id @default(uuid())
  companyId        String
  collaboratorId   String?   // null = horário geral da empresa
  dayOfWeek        DayOfWeek
  openTime         String    // HH:MM
  closeTime        String    // HH:MM
  isOpen           Boolean   @default(true)
  slotDurationMin  Int       @default(30) // granularidade dos slots

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  collaborator Collaborator? @relation(fields: [collaboratorId], references: [id])

  // Nota: Collaborator não tem referência a BusinessHour diretamente
  // mas é unificado via companyId + collaboratorId

  @@index([companyId])
  @@index([companyId, collaboratorId])
}

// Dias especiais (feriados, horários especiais, folgas)
model SpecialDay {
  id             String   @id @default(uuid())
  companyId      String
  collaboratorId String?
  date           Date
  isHoliday      Boolean  @default(false)
  isClosed       Boolean  @default(false)
  openTime       String?  // se não fechado, horário especial
  closeTime      String?
  description    String?

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  collaborator Collaborator? @relation(fields: [collaboratorId], references: [id])

  // Nota: Collaborator sem campo specials explícito — acessado via join
  @@index([companyId, date])
}

// Pausas dos colaboradores (almoço, reunião, etc.)
model Break {
  id             String   @id @default(uuid())
  companyId      String
  collaboratorId String
  date           Date
  startTime      String   // HH:MM
  endTime        String   // HH:MM
  reason         String?
  createdByBot   Boolean  @default(false)
  createdAt      DateTime @default(now())

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  collaborator Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)

  @@index([companyId, collaboratorId, date])
}

// ============================================================
// APPOINTMENTS — Agendamentos
// ============================================================

model Appointment {
  id              String            @id @default(uuid())
  companyId       String
  clientId        String
  collaboratorId  String
  serviceId       String
  status          AppointmentStatus @default(SCHEDULED)
  scheduledDate   Date
  scheduledTime   String            // HH:MM
  endTime         String            // HH:MM (calculado: scheduledTime + duration)
  notes           String?
  internalNotes   String?           // só admin vê
  // Controle
  confirmedAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelledBy     String?           // 'CLIENT' | 'COLLABORATOR' | 'ADMIN'
  cancelReason    String?
  noShowAt        DateTime?
  // Documento exigido pelo serviço
  documentUrl     String?
  documentApproved Boolean?
  // Criação
  createdViaBot   Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client       Client         @relation(fields: [clientId], references: [id])
  collaborator Collaborator   @relation(fields: [collaboratorId], references: [id])
  service      Service        @relation(fields: [serviceId], references: [id])
  payment      Payment?
  absences     ClientAbsence[]

  @@index([companyId])
  @@index([companyId, scheduledDate])
  @@index([companyId, collaboratorId, scheduledDate])
  @@index([companyId, clientId])
  @@index([companyId, status])
}

// ============================================================
// QUEUE — Fila de Atendimento
// ============================================================

model QueueEntry {
  id             String        @id @default(uuid())
  companyId      String
  clientId       String
  collaboratorId String?       // null = qualquer colaborador
  serviceId      String?
  status         QueueStatus   @default(WAITING)
  priority       QueuePriority @default(NORMAL)
  position       Int           // posição atual na fila (recalculada dinamicamente)
  estimatedWait  Int?          // minutos estimados
  notes          String?
  // Tracking
  joinedAt       DateTime      @default(now())
  calledAt       DateTime?
  serviceStartAt DateTime?
  completedAt    DateTime?
  leftAt         DateTime?
  createdViaBot  Boolean       @default(false)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client       Client        @relation(fields: [clientId], references: [id])
  collaborator Collaborator? @relation(fields: [collaboratorId], references: [id])
  service      Service?      @relation(fields: [serviceId], references: [id])

  @@index([companyId, status])
  @@index([companyId, status, priority, joinedAt])
  @@index([clientId, status])
}

// ============================================================
// PAYMENTS — Pagamentos
// ============================================================

model Payment {
  id                String        @id @default(uuid())
  companyId         String
  appointmentId     String?       @unique
  clientId          String
  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(PENDING)
  method            PaymentMethod?
  // Mercado Pago
  mpPaymentId       String?       // ID do pagamento no MP
  mpPreferenceId    String?       // ID da preference (link de pagamento)
  mpPaymentLink     String?       // URL para o cliente pagar
  mpQrCode          String?       // QR code Pix
  mpQrCodeBase64    String?
  paidAt            DateTime?
  refundedAt        DateTime?
  expiresAt         DateTime?
  // Meta
  description       String?
  isAdvancePayment  Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([companyId])
  @@index([companyId, status])
  @@index([mpPaymentId])
}

// ============================================================
// WHATSAPP CONFIG — Configuração por Tenant
// ============================================================

model WhatsappConfig {
  id              String  @id @default(uuid())
  companyId       String  @unique
  instanceName    String  @unique // Evolution API instance name
  instanceKey     String  // API Key do Evolution
  webhookUrl      String?
  isConnected     Boolean @default(false)
  phoneNumber     String? // número conectado
  // Mensagens customizáveis
  greetingMessage        String? @db.Text
  scheduleConfirmMsg     String? @db.Text
  reminderMessage        String? @db.Text
  cancellationMessage    String? @db.Text
  queueCalledMessage     String? @db.Text
  // Configurações
  reminderHoursBefore    Int     @default(2)
  reminderDayBefore      Boolean @default(true)
  autoConfirmHours       Int?    // horas para auto-confirmar (null = não auto-confirma)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ============================================================
// MERCADO PAGO CONFIG
// ============================================================

model MercadopagoConfig {
  id              String  @id @default(uuid())
  companyId       String  @unique
  accessToken     String  // token da conta do tenant
  publicKey       String
  userId          String? // MP user id
  storeId         String?
  webhookSecret   String? // para validar webhooks do MP
  isActive        Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ============================================================
// BUSINESS RULES — Regras do negócio por tenant
// ============================================================

model BusinessRules {
  id                         String  @id @default(uuid())
  companyId                  String  @unique
  // Cancelamento
  cancellationAllowed        Boolean @default(true)
  cancellationMinHours       Int     @default(2) // mínimo de horas de antecedência
  cancellationPenaltyType    String? // NONE | FIXED | PERCENTAGE
  cancellationPenaltyValue   Decimal? @db.Decimal(10, 2)
  // Bloqueio automático
  autoBlockEnabled           Boolean @default(false)
  autoBlockAfterAbsences     Int     @default(3) // faltas
  autoBlockWindowDays        Int     @default(30) // dentro de X dias
  autoBlockDurationDays      Int?    // null = permanente até admin desbloquear
  // Retorno automático
  autoReturnEnabled          Boolean @default(false)
  autoReturnAfterDays        Int     @default(30) // dias sem visita
  autoReturnMessage          String? @db.Text
  // Confirmação
  requireConfirmation        Boolean @default(true)
  confirmationDeadlineHours  Int     @default(24)
  // Cliente novo
  newClientFlow              String  @default("NORMAL") // NORMAL | REQUIRES_APPROVAL
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ============================================================
// NOTIFICATIONS — Histórico de notificações enviadas
// ============================================================

model Notification {
  id             String           @id @default(uuid())
  companyId      String
  clientId       String?
  collaboratorId String?
  type           NotificationType
  whatsappNumber String
  message        String           @db.Text
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  failedAt       DateTime?
  failReason     String?
  mpMessageId    String?          // ID retornado pelo Evolution API
  createdAt      DateTime         @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, type])
  @@index([whatsappNumber])
}

// ============================================================
// CONVERSATION STATE — Estado da conversa WhatsApp
// ============================================================

model ConversationState {
  id             String   @id @default(uuid())
  companyId      String
  whatsappNumber String
  currentStep    String   // nome do step no state machine
  context        Json     @default("{}") // dados acumulados da conversa
  expiresAt      DateTime // TTL: conversa expira após inatividade
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@unique([companyId, whatsappNumber])
  @@index([companyId])
  @@index([expiresAt])
}

// ============================================================
// AUDIT LOGS — Rastreabilidade completa
// ============================================================

model AuditLog {
  id         String   @id @default(uuid())
  companyId  String
  userId     String?  // null se foi via bot
  action     String   // ex: APPOINTMENT_CREATED, CLIENT_BLOCKED
  entity     String   // ex: Appointment, Client
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([companyId, entity, entityId])
  @@index([companyId, createdAt])
}

// ============================================================
// NOTAS DE MODELAGEM
// ============================================================
// 1. Todos os queries DEVEM incluir companyId no WHERE (isolamento tenant)
// 2. O campo `position` em QueueEntry é recalculado dinamicamente
//    via função SQL para evitar gaps (não usar campo fixo)
// 3. ConversationState tem TTL de 30min de inatividade (limpar via cron)
// 4. AuditLog é append-only, nunca atualizar ou deletar
// 5. Todas as datas sensíveis armazenadas em UTC
// 6. whatsappNumber sempre no formato E.164 sem + (ex: 5511999999999)
